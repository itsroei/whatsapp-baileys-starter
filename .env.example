# Copy this file to ".env" and fill in what you need. Everything is optional.

# ── Connection ──
# Link with an 8-character code instead of a QR (your number, with country code, digits only)
# PAIRING_PHONE=972501234567
# Session folder (default: auth)
# AUTH_DIR=auth
# Baileys log level: silent / error / warn / info / debug  (debug when something doesn't work)
# LOG_LEVEL=error

# ── examples/download-media.js ──
# Also save media that YOU send
# MEDIA_INCLUDE_MINE=1

# ── examples/ai-bot.js ──
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# Who the bot answers (comma separated) — or AI_REPLY_ALL=1 for everyone
ALLOWED_NUMBERS=
# AI_REPLY_ALL=1
# AI_SYSTEM_PROMPT=You are a friendly assistant chatting on WhatsApp. Reply short and natural.
